# =============================================================================
# REQUIRED - Application will not start without these
# =============================================================================

# Database connection (Replit provides this automatically)
DATABASE_URL=postgres://user:password@host:port/database

# JWT secret for token signing (generate with: openssl rand -hex 32)
JWT_SECRET=your-secure-secret-key-here

# =============================================================================
# REQUIRED FOR TEAMWORK DESK INTEGRATION
# =============================================================================

# Encryption key for storing API keys (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# =============================================================================
# OPTIONAL - Application degrades gracefully without these
# =============================================================================

# Email service configuration
# If not set: Password reset tokens logged to console in dev, warning in prod
EMAIL_ENABLED=false
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_xxxx

# Application URL (used for email links)
# Defaults to http://localhost:5000 in dev
BASE_URL=https://your-app.replit.app

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================

# Set to 'development' for dev mode features (token logging, etc.)
NODE_ENV=development
